    // 3. LECTURE SCHEDULE TIMETABLE
    function LectureScheduleView({ appData, setAppData, toggleLectureStatus, showToast }) {
      const [viewMode, setViewMode] = useState('weekly');
      const [subjectFilter, setSubjectFilter] = useState('all');
      const [statusFilter, setStatusFilter] = useState('all');
      const [searchQuery, setSearchQuery] = useState('');
      const [selectedDate, setSelectedDate] = useState('2026-11-16');

      const [newLecSubject, setNewLecSubject] = useState('accounting');
      const [newLecChapter, setNewLecChapter] = useState('acc-1');
      const [newLecTopic, setNewLecTopic] = useState('');
      const [newLecDate, setNewLecDate] = useState('2026-11-16');

      const filteredLectures = useMemo(() => {
        return appData.lectures.filter((lec) => {
          if (subjectFilter !== 'all' && lec.subjectId !== subjectFilter) return false;
          if (statusFilter !== 'all' && lec.status !== statusFilter) return false;
          if (viewMode === 'daily' && selectedDate && lec.date !== selectedDate) return false;
          if (viewMode === 'monthly' && lec.date !== 'Recorded') return false;
          if (searchQuery.trim()) {
            const ch = appData.chapters.find((c) => c.id === lec.chapterId);
            const q = searchQuery.toLowerCase();
            if (!lec.topic.toLowerCase().includes(q) && !ch?.name.toLowerCase().includes(q)) return false;
          }
          return true;
        });
      }, [appData.lectures, appData.chapters, subjectFilter, statusFilter, viewMode, selectedDate, searchQuery]);

      const handleAddPersonalLecture = (e) => {
        e.preventDefault();
        if (!newLecTopic.trim()) return;
        const subj = SUBJECTS.find((s) => s.id === newLecSubject);
        setAppData((prev) => ({
          ...prev,
          lectures: [
            ...prev.lectures,
            {
              id: `custom-lec-${Date.now()}`,
              subjectId: newLecSubject,
              chapterId: newLecChapter,
              lectureNumber: 99,
              topic: newLecTopic.trim(),
              date: newLecDate || 'Recorded',
              faculty: subj?.faculty || 'Self Study',
              timing: subj?.defaultTiming || 'Custom',
              isRecorded: false,
              status: 'Pending'
            }
          ]
        }));
        setNewLecTopic('');
        showToast('Personal lecture added to schedule!');
      };

      return (
        <div className="space-y-6 animate-view-enter">
          <div className="p-6 rounded-2xl bg-[#141418] border border-[#272730] space-y-4">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h1 className="text-xl font-black text-white">Complete Official Lecture Schedule</h1>
                <p className="text-xs text-zinc-400">All 402 lectures imported from Accounting, Business Laws, Quantitative Aptitude & Business Economics PDFs</p>
              </div>
              <div className="flex items-center gap-2">
                {[
                  { id: 'weekly', label: 'Full Timetable' },
                  { id: 'daily', label: 'Filter by Date' },
                  { id: 'monthly', label: 'Recorded Lectures' }
                ].map((v) => (
                  <button
                    key={v.id}
                    onClick={() => setViewMode(v.id)}
                    className={`px-3.5 py-2 rounded-xl text-xs font-bold ${viewMode === v.id ? 'bg-purple-600 text-white' : 'bg-[#1c1c24] text-zinc-400 hover:text-white'}`}
                  >
                    {v.label}
                  </button>
                ))}
              </div>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <input type="text" value={searchQuery} onChange={(e) => setSearchQuery(e.target.value)} placeholder="Search chapter or lecture..." className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white" />
              <select value={subjectFilter} onChange={(e) => setSubjectFilter(e.target.value)} className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white">
                <option value="all">All 4 Subjects</option>
                {SUBJECTS.map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
              </select>
              <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value)} className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white">
                <option value="all">All Statuses</option>
                <option value="Pending">Pending</option>
                <option value="Completed">Completed</option>
                <option value="Missed">Missed</option>
                <option value="Recorded">Recorded</option>
              </select>
              {viewMode === 'daily' && (
                <input type="date" value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white" />
              )}
            </div>

            <form onSubmit={handleAddPersonalLecture} className="pt-3 border-t border-[#252530] grid grid-cols-1 sm:grid-cols-5 gap-2">
              <select
                value={newLecSubject}
                onChange={(e) => {
                  setNewLecSubject(e.target.value);
                  const firstCh = appData.chapters.find((c) => c.subjectId === e.target.value);
                  if (firstCh) setNewLecChapter(firstCh.id);
                }}
                className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white"
              >
                {SUBJECTS.map((s) => <option key={s.id} value={s.id}>{s.name}</option>)}
              </select>
              <select value={newLecChapter} onChange={(e) => setNewLecChapter(e.target.value)} className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white">
                {appData.chapters.filter((c) => c.subjectId === newLecSubject).map((c) => (
                  <option key={c.id} value={c.id}>Ch {c.number}: {c.name}</option>
                ))}
              </select>
              <input type="text" value={newLecTopic} onChange={(e) => setNewLecTopic(e.target.value)} placeholder="Personal lecture topic..." className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white" />
              <input type="date" value={newLecDate} onChange={(e) => setNewLecDate(e.target.value)} className="px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white" />
              <button type="submit" className="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold">+ Add Personal Lecture</button>
            </form>
          </div>

          <div className="space-y-2.5">
            {filteredLectures.map((lec) => {
              const subj = SUBJECTS.find((s) => s.id === lec.subjectId);
              const ch = appData.chapters.find((c) => c.id === lec.chapterId);
              const isDone = lec.status === 'Completed';
              return (
                <div key={lec.id} className="p-4 rounded-2xl bg-[#141418] border border-[#272730] flex flex-wrap items-center justify-between gap-3">
                  <div className="space-y-0.5">
                    <div className="text-[11px] font-bold text-purple-400">{subj?.name} • {ch?.name} • Lecture #{lec.lectureNumber}</div>
                    <div className="text-sm font-extrabold text-white">{lec.topic}</div>
                    <div className="text-xs text-zinc-400">
                      Date: <strong className="text-zinc-200">{formatDateDDMMMYYYY(lec.date)}</strong> • Timing: {lec.timing} • Faculty: {lec.faculty}
                    </div>
                  </div>
                  <div className="flex items-center gap-2">
                    <select value={lec.status} onChange={(e) => toggleLectureStatus(lec.id, e.target.value)} className="px-3 py-1.5 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs font-bold text-white">
                      <option value="Pending">Pending</option>
                      <option value="Completed">Completed</option>
                      <option value="Missed">Missed</option>
                      <option value="Recorded">Recorded</option>
                    </select>
                    <button onClick={() => toggleLectureStatus(lec.id)} className={`px-3.5 py-1.5 rounded-xl text-xs font-bold ${isDone ? 'bg-emerald-600 text-white' : 'bg-purple-600 text-white'}`}>
                      {isDone ? 'Completed ✓' : 'Mark Completed'}
                    </button>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    }

