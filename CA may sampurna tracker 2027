        id: 'card-4',
        subjectId: 'economics',
        chapterId: 'eco-3',
        concept: 'Price Elasticity of Demand (Arc & Point)',
        explanation: 'Responsiveness of quantity demanded of a good to a change in its price, ceteris paribus.',
        formulaOrSection: 'Ep = (ΔQ / ΔP) × (P1 + P2) / (Q1 + Q2)',
        question: 'When price falls from ₹20 to ₹16, quantity demanded rises from 100 to 140 units. Calculate Arc Elasticity.',
        revised: false
      }
    ];

    const buildInitialData = () => ({
      chapters: INITIAL_CHAPTERS.map((ch) => ({ ...ch, completedManual: false, completedAt: null })),
      lectures: buildOfficialLectures(),
      notes: [],
      dpps: [],
      exercises: [],
      customMaterials: [],
      revisionTasks: [],
      flashcards: INITIAL_FLASHCARDS,
      focusSessions: [],
      dailyTasks: [
        { id: 'dt-1', text: 'Complete 2 Accounting lectures', completed: false },
        { id: 'dt-2', text: 'Solve 1 Business Laws DPP', completed: false },
        { id: 'dt-3', text: 'Practise 30 Quantitative Aptitude questions', completed: false },
        { id: 'dt-4', text: 'Revise 1 Business Economics chapter', completed: false }
      ],
      portalMatrix: buildDefaultPortalMatrix(),
      settings: {
        examDate: '2027-05-15',
        dailyTargetHours: 6,
        theme: 'dark',
        studentName: 'Aspirant'
      }
    });

    const PRIMARY_STORAGE_KEY = 'ca_foundation_sampurna_may_2027_permanent_v1';
    const UNIFIED_SILENT_MEET_KEY = 'ca_sampurna_2027_unified_silent_meet_v1';

    const loadPermanentPlannerData = () => {
      const defaults = buildInitialData();
      try {
        const raw = localStorage.getItem(PRIMARY_STORAGE_KEY);
        if (!raw) return defaults;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return defaults;

        const savedLecturesMap = new Map(Array.isArray(parsed.lectures) ? parsed.lectures.map((l) => [l.id, l]) : []);
        const mergedLectures = defaults.lectures.map((defLec) => {
          const savedLec = savedLecturesMap.get(defLec.id);
          return savedLec ? { ...defLec, ...savedLec } : defLec;
        });
        const customLectures = Array.isArray(parsed.lectures)
          ? parsed.lectures.filter((l) => String(l.id).startsWith('custom-lec-'))
          : [];

        const savedChaptersMap = new Map(Array.isArray(parsed.chapters) ? parsed.chapters.map((c) => [c.id, c]) : []);
        const mergedChapters = defaults.chapters.map((defCh) => {
          const savedCh = savedChaptersMap.get(defCh.id);
          return savedCh ? { ...defCh, ...savedCh } : defCh;
        });

        return {
          ...defaults,
          ...parsed,
          chapters: mergedChapters,
          lectures: [...mergedLectures, ...customLectures],
          settings: {
            ...defaults.settings,
            ...(parsed.settings || {})
          }
        };
      } catch {
        return defaults;
      }
    };

    function App() {
      const [appData, setAppData] = useState(() => loadPermanentPlannerData());
      const [lastSavedAt, setLastSavedAt] = useState(() =>
        new Intl.DateTimeFormat('en-IN', {
          timeZone: 'Asia/Kolkata',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit'
        }).format(new Date())
      );

      const [unifiedSilentMeet, setUnifiedSilentMeet] = useState(() => {
        try {
          const saved = localStorage.getItem(UNIFIED_SILENT_MEET_KEY);
          if (saved) return JSON.parse(saved);
        } catch {}
        return { meetUrl: 'https://meet.google.com/landing', hostName: 'CA. Beeresh' };
      });

      useEffect(() => {
        try {
          localStorage.setItem(UNIFIED_SILENT_MEET_KEY, JSON.stringify(unifiedSilentMeet));
        } catch {}
      }, [unifiedSilentMeet]);

      const [activeNav, setActiveNav] = useState('dashboard');
      const [activeSubjectId, setActiveSubjectId] = useState('accounting');
      const [activeChapterId, setActiveChapterId] = useState(null);
      const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
      const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
      const [toast, setToast] = useState(null);

      const todayISO = getTodayISO();
      const [selectedDashboardDate, setSelectedDashboardDate] = useState('2026-11-16');
      const [simulatedPacePerDay, setSimulatedPacePerDay] = useState(3);
      const [referenceDateISO, setReferenceDateISO] = useState(todayISO);

      useEffect(() => {
        try {
          localStorage.setItem(PRIMARY_STORAGE_KEY, JSON.stringify(appData));
          setLastSavedAt(
            new Intl.DateTimeFormat('en-IN', {
              timeZone: 'Asia/Kolkata',
              hour: '2-digit',
              minute: '2-digit',
              second: '2-digit'
            }).format(new Date())
          );
        } catch {}
      }, [appData]);

      const showToast = (msg) => {
        setToast(msg);
        setTimeout(() => setToast(null), 3000);
      };

      const [countdown, setCountdown] = useState({ days: 0, hours: 0, minutes: 0, seconds: 0 });
      useEffect(() => {
        const updateCountdown = () => {
          const target = new Date(`${appData.settings.examDate}T09:00:00+05:30`).getTime();
          const diff = Math.max(0, target - Date.now());
          setCountdown({
            days: Math.floor(diff / (1000 * 60 * 60 * 24)),
            hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
            minutes: Math.floor((diff / (1000 * 60)) % 60),
            seconds: Math.floor((diff / 1000) % 60)
          });
        };
        updateCountdown();
        const t = setInterval(updateCountdown, 1000);
        return () => clearInterval(t);
      }, [appData.settings.examDate]);

      const stats = useMemo(() => {
        const chapterStatsMap = {};
        appData.chapters.forEach((ch) => {
          const chLecs = appData.lectures.filter((l) => l.chapterId === ch.id);
          const totalLectures = chLecs.length;
          const completedLectures = chLecs.filter((l) => l.status === 'Completed').length;
          const lecturePct = totalLectures > 0 ? Math.round((completedLectures / totalLectures) * 100) : 0;
          const isCompleted = ch.completedManual || (totalLectures > 0 && completedLectures === totalLectures);
          const progressPct = isCompleted ? 100 : lecturePct;

          chapterStatsMap[ch.id] = {
            ...ch,
            totalLectures,
            completedLectures,
            totalNotes: appData.notes.filter((n) => n.chapterId === ch.id).length,
            totalDpps: appData.dpps.filter((d) => d.chapterId === ch.id).length,
            totalExercises: appData.exercises.filter((e) => e.chapterId === ch.id).length,
            isCompleted,
            progressPct
          };
        });

        const subjectStatsMap = {};
        SUBJECTS.forEach((subj) => {
          const subjChs = appData.chapters.filter((c) => c.subjectId === subj.id).map((c) => chapterStatsMap[c.id]);
          const totalChapters = subjChs.length;
          const completedChapters = subjChs.filter((c) => c.isCompleted).length;
          const subjLecs = appData.lectures.filter((l) => l.subjectId === subj.id);
          const totalLectures = subjLecs.length;
          const completedLectures = subjLecs.filter((l) => l.status === 'Completed').length;
          const completionPct = totalLectures > 0 ? Math.round((completedLectures / totalLectures) * 100) : 0;

          const datedDue = subjLecs.filter((l) => l.date !== 'Recorded' && l.date <= referenceDateISO).length;
          const recordedTotal = subjLecs.filter((l) => l.date === 'Recorded').length;
          const daysSinceStart = Math.max(1, Math.min(45, Math.floor((new Date(referenceDateISO).getTime() - new Date('2026-11-16').getTime()) / 86400000) + 1));
          const expectedRecordedDue = referenceDateISO >= '2026-11-16' ? Math.round((daysSinceStart / 45) * recordedTotal) : 0;
          const expectedLecturesDue = Math.min(totalLectures, datedDue + expectedRecordedDue);
          const backlogLectures = Math.max(0, expectedLecturesDue - completedLectures);
          const paceRatio = expectedLecturesDue > 0 ? Math.round((completedLectures / expectedLecturesDue) * 100) : 100;

          let riskStatus = 'SAFE';
          if (expectedLecturesDue > 0) {
            if (paceRatio < 65 || backlogLectures >= 8) riskStatus = 'AT RISK';
            else if (paceRatio < 88 || backlogLectures >= 3) riskStatus = 'MODERATE RISK';
          }

          subjectStatsMap[subj.id] = {
            ...subj,
            totalChapters,
            completedChapters,
            pendingChapters: totalChapters - completedChapters,
            totalLectures,
            completedLectures,
            completionPct,
            expectedLecturesDue,
            backlogLectures,
            riskStatus
          };
        });

        const totalChapters = appData.chapters.length;
        const completedChapters = Object.values(chapterStatsMap).filter((c) => c.isCompleted).length;
        const totalLectures = appData.lectures.length;
        const completedLectures = appData.lectures.filter((l) => l.status === 'Completed').length;
        const pendingLectures = totalLectures - completedLectures;
        const overallPct = totalLectures > 0 ? Math.round((completedLectures / totalLectures) * 100) : 0;

        const totalExpectedDue = Object.values(subjectStatsMap).reduce((acc, s) => acc + s.expectedLecturesDue, 0);
        const totalBacklogDue = Math.max(0, totalExpectedDue - completedLectures);
        const overallPaceRatio = totalExpectedDue > 0 ? Math.round((completedLectures / totalExpectedDue) * 100) : 100;

        let overallRisk = 'SAFE';
        if (totalExpectedDue > 0) {
          if (overallPaceRatio < 65 || totalBacklogDue >= 15) overallRisk = 'AT RISK';
          else if (overallPaceRatio < 88 || totalBacklogDue >= 6) overallRisk = 'MODERATE RISK';
        }

        const daysLeftToExam = Math.max(1, Math.ceil((new Date(appData.settings.examDate).getTime() - new Date(referenceDateISO).getTime()) / 86400000));
        const requiredDailyVelocity = (pendingLectures / daysLeftToExam).toFixed(1);
        const projectedCompletionDate = addDaysISO(referenceDateISO, Math.ceil(pendingLectures / Math.max(0.5, simulatedPacePerDay)));

        return {
          chapterStatsMap,
          subjectStatsMap,
          totalChapters,
          completedChapters,
          pendingChapters: totalChapters - completedChapters,
          totalLectures,
          completedLectures,
          pendingLectures,
          overallPct,
          totalExpectedDue,
          overallRisk,
          requiredDailyVelocity,
          projectedCompletionDate
        };
      }, [appData, referenceDateISO, simulatedPacePerDay]);

      const createRevisionStagesForChapter = (chapterId, existingRevisions) => {
        if ((existingRevisions || []).some((r) => r.chapterId === chapterId)) return existingRevisions;
        return [
          ...(existingRevisions || []),
          { id: `rev-${chapterId}-1`, chapterId, stage: 1, label: 'Revision 1 (After 1 Day)', dueDate: addDaysISO(todayISO, 1), completed: false },
          { id: `rev-${chapterId}-2`, chapterId, stage: 2, label: 'Revision 2 (After 7 Days)', dueDate: addDaysISO(todayISO, 7), completed: false },
          { id: `rev-${chapterId}-3`, chapterId, stage: 3, label: 'Revision 3 (After 30 Days)', dueDate: addDaysISO(todayISO, 30), completed: false }
        ];
      };

      const toggleLectureStatus = (lectureId, nextStatus = null) => {
        setAppData((prev) => {
          const targetLec = prev.lectures.find((l) => l.id === lectureId);
          if (!targetLec) return prev;
          const resolvedStatus = nextStatus || (targetLec.status === 'Completed' ? 'Pending' : 'Completed');
          const updatedLectures = prev.lectures.map((l) => l.id === lectureId ? { ...l, status: resolvedStatus } : l);
          const chLectures = updatedLectures.filter((l) => l.chapterId === targetLec.chapterId);
          const allChDone = chLectures.length > 0 && chLectures.every((l) => l.status === 'Completed');
          const updatedChapters = prev.chapters.map((c) =>
            c.id === targetLec.chapterId
              ? { ...c, completedManual: allChDone ? true : c.completedManual, completedAt: allChDone ? todayISO : c.completedAt }
              : c
          );
          const updatedRevisions = allChDone
            ? createRevisionStagesForChapter(targetLec.chapterId, prev.revisionTasks)
            : prev.revisionTasks;
          return { ...prev, lectures: updatedLectures, chapters: updatedChapters, revisionTasks: updatedRevisions };
        });
      };

      const toggleChapterCompleteManual = (chapterId) => {
        setAppData((prev) => {
          const ch = prev.chapters.find((c) => c.id === chapterId);
          if (!ch) return prev;
          const nextDone = !ch.completedManual;
          const updatedRevisions = nextDone
            ? createRevisionStagesForChapter(chapterId, prev.revisionTasks)
            : prev.revisionTasks;
          return {
            ...prev,
            chapters: prev.chapters.map((c) => c.id === chapterId ? { ...c, completedManual: nextDone, completedAt: nextDone ? todayISO : null } : c),
            lectures: prev.lectures.map((l) => l.chapterId === chapterId ? { ...l, status: nextDone ? 'Completed' : 'Pending' } : l),
            revisionTasks: updatedRevisions
          };
        });
        showToast('Chapter progress updated & saved!');
      };

      const openSubjectDashboard = (subjectId) => {
        setActiveSubjectId(subjectId);
        setActiveChapterId(null);
        setActiveNav(`subject-${subjectId}`);
        setMobileMenuOpen(false);
      };

      const openChapterWorkspace = (chapterId) => {
        const ch = appData.chapters.find((c) => c.id === chapterId);
        if (ch) setActiveSubjectId(ch.subjectId);
        setActiveChapterId(chapterId);
        setActiveNav('chapter-workspace');
        setMobileMenuOpen(false);
      };

      const isDark = appData.settings.theme !== 'light';
      const cleanStudentName = String(appData.settings.studentName || 'Aspirant').replace(/^CA\.?\s*/i, '').trim();

      const navItems = [
        { id: 'dashboard', label: '1. Dashboard', icon: LayoutDashboard },
        { id: 'schedule', label: '2. Lecture Schedule', icon: Calendar },
        { id: 'tracker', label: '3. Syllabus Tracker', icon: CheckCircle2 },
        {
          id: 'subjects-group',
          label: '4. Subjects',
          icon: BookOpen,
          children: SUBJECTS.map((s) => ({ id: `subject-${s.id}`, subjectId: s.id, label: s.name }))
        },
        { id: 'materials', label: '5. Study Materials', icon: FolderOpen },
        { id: 'revision', label: '6. Revision Centre', icon: RefreshCw },
        { id: 'timer', label: '7. Focus Timer', icon: Timer },
        { id: 'mtp-rtp', label: '8. MTP & RTP', icon: Award },
        { id: 'backlog', label: '9. Backlog Manager', icon: AlertTriangle },
        { id: 'analytics', label: '10. Analytics', icon: BarChart3 },
        { id: 'silent-meet', label: '11. Silent Study Meet', icon: Video },
        { id: 'settings', label: '12. Settings', icon: Settings }
      ];

      return (
        <div className={`min-h-screen flex ${isDark ? 'bg-[#0b0b0e] text-zinc-100' : 'bg-zinc-100 text-zinc-900'}`}>
          {toast && (
            <div className="fixed bottom-5 right-5 z-50 px-4 py-3 rounded-xl bg-purple-600 text-white text-xs font-bold shadow-2xl flex items-center gap-2">
              <Sparkles className="w-4 h-4" />
              <span>{toast}</span>
            </div>
          )}

          {mobileMenuOpen && (
            <div onClick={() => setMobileMenuOpen(false)} className="fixed inset-0 z-40 bg-black/70 lg:hidden" />
          )}

          {/* Sidebar */}
          <aside className={`fixed lg:static inset-y-0 left-0 z-40 flex flex-col border-r bg-[#111116] border-[#23232c] transition-all ${sidebarCollapsed ? 'w-20' : 'w-64'} ${mobileMenuOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}`}>
            <div className="p-4 flex items-center justify-between border-b border-[#23232c]">
              {!sidebarCollapsed && (
                <div className="truncate">
                  <div className="text-xs font-black tracking-wider text-purple-400 uppercase">CA FOUNDATION</div>
                  <div className="text-sm font-extrabold text-white truncate">SAMPURNA MAY 2027</div>
                </div>
              )}
              <button onClick={() => setSidebarCollapsed(!sidebarCollapsed)} className="p-2 rounded-lg hover:bg-zinc-800 text-zinc-400 hidden lg:inline-flex">
                {sidebarCollapsed ? <ChevronRight /> : <ChevronLeft />}
              </button>
              <button onClick={() => setMobileMenuOpen(false)} className="p-2 rounded-lg hover:bg-zinc-800 text-zinc-400 lg:hidden">
                <X />
              </button>
            </div>

            <nav className="flex-1 overflow-y-auto p-3 space-y-1">
              {navItems.map((item) => {
                const Icon = item.icon;
                if (item.children) {
                  return (
                    <div key={item.id} className="pt-2 pb-1">
                      {!sidebarCollapsed && (
                        <div className="px-3 py-1 text-[10px] font-extrabold uppercase tracking-wider text-zinc-500 flex items-center gap-2">
                          <Icon className="w-3.5 h-3.5 text-purple-400" />
                          <span>{item.label}</span>
                        </div>
                      )}
                      <div className="mt-1 space-y-1">
                        {item.children.map((sub) => {
                          const isSubActive = activeNav === sub.id || (activeNav === 'chapter-workspace' && activeSubjectId === sub.subjectId);
                          return (
                            <button
                              key={sub.id}
                              onClick={() => openSubjectDashboard(sub.subjectId)}
                              className={`w-full flex items-center gap-2.5 px-3 py-2 rounded-xl text-xs font-semibold ${isSubActive ? 'bg-purple-600 text-white' : 'text-zinc-400 hover:bg-[#1b1b24]'}`}
                            >
                              <span className="w-2 h-2 rounded-full bg-purple-400 shrink-0" />
                              {!sidebarCollapsed && <span className="truncate">{sub.label}</span>}
                            </button>
                          );
                        })}
                      </div>
                    </div>
                  );
                }
                return (
                  <button
                    key={item.id}
                    onClick={() => { setActiveNav(item.id); setMobileMenuOpen(false); }}
                    className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold ${activeNav === item.id ? 'bg-purple-600 text-white' : 'text-zinc-400 hover:bg-[#1b1b24]'}`}
                  >
                    <Icon className="w-4 h-4 shrink-0" />
                    {!sidebarCollapsed && <span className="truncate">{item.label}</span>}
                  </button>
                );
              })}
            </nav>

            {!sidebarCollapsed && (
              <div className="p-3 m-3 rounded-xl bg-[#16161d] border border-[#262632] space-y-1.5">
                <div className="flex items-center justify-between text-[11px] font-bold">
                  <span className="text-zinc-400">Overall Syllabus</span>
                  <span className="text-purple-400">{stats.overallPct}%</span>
                </div>
                <div className="w-full h-1.5 bg-zinc-800 rounded-full overflow-hidden">
                  <div className="h-full bg-purple-500 transition-all duration-300" style={{ width: `${stats.overallPct}%` }} />
                </div>
                <div className="text-[10px] text-zinc-500">{stats.completedLectures} / {stats.totalLectures} Lectures Done</div>
              </div>
            )}
          </aside>

          {/* Main Area */}
          <div className="flex-1 flex flex-col min-w-0">
            <header className="sticky top-0 z-30 px-4 sm:px-6 py-3.5 border-b bg-[#0b0b0e]/90 border-[#22222b] backdrop-blur-md flex flex-wrap items-center justify-between gap-3">
              <div className="flex items-center gap-3">
                <button onClick={() => setMobileMenuOpen(true)} className="p-2 rounded-xl bg-[#181820] border border-[#2a2a36] text-zinc-300 lg:hidden">
                  <Menu />
                </button>
                <div>
                  <div className="flex items-center gap-2">
                    <span className="text-sm sm:text-base font-black text-white">CA FOUNDATION – SAMPURNA MAY 2027</span>
                    <span className="hidden md:inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                      <Save className="w-3 h-3" /> Auto-Saved ({lastSavedAt})
                    </span>
                  </div>
                  <p className="text-[11px] text-zinc-400">Plan Smart. Study Consistently. Become a CA.</p>
                </div>
              </div>
              <div className="flex items-center gap-2">
                <div className="px-3 py-1.5 rounded-xl bg-[#16161f] border border-[#292936] text-xs font-bold text-purple-300">
                  CA. {cleanStudentName}
                </div>
                <button
                  onClick={() => setAppData((prev) => ({ ...prev, settings: { ...prev.settings, theme: prev.settings.theme === 'light' ? 'dark' : 'light' } }))}
                  className="p-2 rounded-xl bg-[#16161f] border border-[#292936] text-zinc-300 hover:text-white"
                  title="Toggle Theme"
                >
                  {isDark ? <Sun /> : <Moon />}
                </button>
              </div>
            </header>

            <main className="flex-1 p-4 sm:p-6 max-w-7xl w-full mx-auto">
              {activeNav === 'dashboard' && (
                <DashboardView
                  appData={appData}
                  setAppData={setAppData}
                  stats={stats}
                  countdown={countdown}
                  todayISO={todayISO}
                  selectedDashboardDate={selectedDashboardDate}
                  setSelectedDashboardDate={setSelectedDashboardDate}
                  referenceDateISO={referenceDateISO}
                  setReferenceDateISO={setReferenceDateISO}
                  simulatedPacePerDay={simulatedPacePerDay}
                  setSimulatedPacePerDay={setSimulatedPacePerDay}
                  openSubjectDashboard={openSubjectDashboard}
                  setActiveNav={setActiveNav}
                  toggleLectureStatus={toggleLectureStatus}
                  showToast={showToast}
                />
              )}

              {activeNav.startsWith('subject-') && (
                <SubjectDashboardView
                  subjectId={activeNav.replace('subject-', '')}
                  stats={stats}
                  openChapterWorkspace={openChapterWorkspace}
                  toggleChapterCompleteManual={toggleChapterCompleteManual}
                />
              )}

              {activeNav === 'chapter-workspace' && activeChapterId && (
                <ChapterWorkspaceView
                  chapterId={activeChapterId}
                  appData={appData}
                  setAppData={setAppData}
                  stats={stats}
                  toggleLectureStatus={toggleLectureStatus}
                  toggleChapterCompleteManual={toggleChapterCompleteManual}
                  openSubjectDashboard={openSubjectDashboard}
                  showToast={showToast}
                />
              )}

              {activeNav === 'schedule' && (
                <LectureScheduleView
                  appData={appData}
                  setAppData={setAppData}
                  toggleLectureStatus={toggleLectureStatus}
                  showToast={showToast}
                />
              )}

              {activeNav === 'tracker' && <SyllabusTrackerView stats={stats} />}

              {activeNav === 'materials' && (
                <StudyMaterialsView appData={appData} setAppData={setAppData} showToast={showToast} />
              )}

              {activeNav === 'revision' && (
                <RevisionCentreView appData={appData} setAppData={setAppData} showToast={showToast} />
              )}

              {activeNav === 'timer' && (
                <FocusTimerView appData={appData} setAppData={setAppData} todayISO={todayISO} showToast={showToast} />
              )}

              {activeNav === 'mtp-rtp' && (
                <MtpRtpView appData={appData} setAppData={setAppData} showToast={showToast} />
              )}

              {activeNav === 'backlog' && (
                <BacklogManagerView appData={appData} referenceDateISO={referenceDateISO} toggleLectureStatus={toggleLectureStatus} />
              )}

              {activeNav === 'analytics' && <AnalyticsView stats={stats} />}

              {activeNav === 'silent-meet' && (
                <GoogleMeetRoomView
                  unifiedSilentMeet={unifiedSilentMeet}
                  setUnifiedSilentMeet={setUnifiedSilentMeet}
                  showToast={showToast}
                />
              )}

              {activeNav === 'settings' && (
                <SettingsView appData={appData} setAppData={setAppData} showToast={showToast} />
              )}
            </main>
          </div>
        </div>
      );
    }

    // 1. MAIN DASHBOARD VIEW
    function DashboardView({
      appData, setAppData, stats, countdown, todayISO,
      selectedDashboardDate, setSelectedDashboardDate,
      referenceDateISO, setReferenceDateISO,
      simulatedPacePerDay, setSimulatedPacePerDay,
      openSubjectDashboard, setActiveNav, toggleLectureStatus, showToast
    }) {
      const [newTaskText, setNewTaskText] = useState('');
      const cleanName = String(appData.settings.studentName || 'Aspirant').replace(/^CA\.?\s*/i, '').trim();
      const todaysLectures = appData.lectures.filter((l) => l.date === selectedDashboardDate);
      const pendingDpps = appData.dpps.filter((d) => !d.completed);
      const dueRevisions = appData.revisionTasks.filter((r) => !r.completed);
      const completedDailyTasks = appData.dailyTasks.filter((t) => t.completed).length;
      const dailyMissionPct = appData.dailyTasks.length > 0 ? Math.round((completedDailyTasks / appData.dailyTasks.length) * 100) : 0;

