            </div>
            <div className="pt-3 border-t border-[#252530] flex flex-wrap gap-3">
              <button type="button" onClick={handleExportBackup} className="px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold inline-flex items-center gap-2">
                <Download /> Export Planner Backup (.json)
              </button>
              <label className="cursor-pointer px-4 py-2.5 rounded-xl bg-[#1c1c22] border border-[#2e2e3a] text-zinc-200 text-xs font-bold inline-flex items-center gap-2">
                <Upload /> Restore Backup (.json)
                <input type="file" accept=".json" onChange={handleImportBackup} className="hidden" />
              </label>
            </div>
          </div>
        </div>
      );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
</body>
</html>
