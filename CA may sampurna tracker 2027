    // 2B. 5-TAB CHAPTER WORKSPACE
    function ChapterWorkspaceView({
      chapterId, appData, setAppData, stats,
      toggleLectureStatus, toggleChapterCompleteManual, openSubjectDashboard, showToast
    }) {
      const [activeTab, setActiveTab] = useState('lectures');
      const chStat = stats.chapterStatsMap[chapterId];
      const subject = SUBJECTS.find((s) => s.id === chStat?.subjectId);
      const [noteTitle, setNoteTitle] = useState('');
      const [noteContent, setNoteContent] = useState('');
      const [dppTitle, setDppTitle] = useState('');
      const [dppMarks, setDppMarks] = useState('');
      const [exTitle, setExTitle] = useState('');
      const [exAttempted, setExAttempted] = useState('');
      const [exCorrect, setExCorrect] = useState('');

      if (!chStat) return null;

      const chLectures = appData.lectures.filter((l) => l.chapterId === chapterId);
      const chNotes = appData.notes.filter((n) => n.chapterId === chapterId);
      const chDpps = appData.dpps.filter((d) => d.chapterId === chapterId);
      const chExercises = appData.exercises.filter((e) => e.chapterId === chapterId);
      const chRevisions = appData.revisionTasks.filter((r) => r.chapterId === chapterId);

      const handleAddNote = (e) => {
        e.preventDefault();
        if (!noteTitle.trim()) return;
        setAppData((prev) => ({
          ...prev,
          notes: [...prev.notes, { id: `note-${Date.now()}`, subjectId: chStat.subjectId, chapterId, title: noteTitle.trim(), content: noteContent.trim(), createdAt: getTodayISO() }]
        }));
        setNoteTitle('');
        setNoteContent('');
        showToast('Chapter note saved!');
      };

      const handleAddDpp = (e) => {
        e.preventDefault();
        if (!dppTitle.trim()) return;
        setAppData((prev) => ({
          ...prev,
          dpps: [...prev.dpps, { id: `dpp-${Date.now()}`, subjectId: chStat.subjectId, chapterId, title: dppTitle.trim(), marks: dppMarks || '-', completed: false }]
        }));
        setDppTitle('');
        setDppMarks('');
        showToast('DPP added to chapter!');
      };

      const handleAddExercise = (e) => {
        e.preventDefault();
        if (!exTitle.trim()) return;
        setAppData((prev) => ({
          ...prev,
          exercises: [...prev.exercises, { id: `ex-${Date.now()}`, subjectId: chStat.subjectId, chapterId, title: exTitle.trim(), attempted: Number(exAttempted) || 0, correct: Number(exCorrect) || 0, completed: true }]
        }));
        setExTitle('');
        setExAttempted('');
        setExCorrect('');
        showToast('Practice exercise recorded!');
      };

      return (
        <div className="space-y-6 animate-view-enter">
          <div className="p-6 rounded-2xl bg-[#141418] border border-[#272730] space-y-4">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <button onClick={() => openSubjectDashboard(chStat.subjectId)} className="inline-flex items-center gap-2 text-xs font-bold text-purple-400 hover:text-purple-300">
                <ArrowLeft /> Back to {subject?.name}
              </button>
              <button
                onClick={() => toggleChapterCompleteManual(chapterId)}
                className={`px-4 py-2 rounded-xl text-xs font-bold ${chStat.isCompleted ? 'bg-emerald-600 text-white' : 'bg-purple-600 hover:bg-purple-500 text-white'}`}
              >
                {chStat.isCompleted ? 'Chapter Completed ✓' : 'Mark Entire Chapter Completed'}
              </button>
            </div>
            <div>
              <div className="text-xs font-bold text-purple-400 uppercase">{subject?.name} • Chapter {chStat.number}</div>
              <h1 className="text-2xl font-black text-white mt-0.5">{chStat.name}</h1>
              <div className="text-xs text-zinc-400 mt-1">{chStat.completedLectures} / {chStat.totalLectures} Lectures Completed ({chStat.progressPct}%)</div>
            </div>
            <div className="flex flex-wrap gap-2 pt-2 border-t border-[#252530]">
              {[
                { id: 'lectures', label: `1. Lectures (${chLectures.length})` },
                { id: 'notes', label: `2. Notes (${chNotes.length})` },
                { id: 'dpp', label: `3. DPP (${chDpps.length})` },
                { id: 'exercises', label: `4. Exercises (${chExercises.length})` },
                { id: 'revision', label: `5. Revision (${chRevisions.length})` }
              ].map((t) => (
                <button
                  key={t.id}
                  onClick={() => setActiveTab(t.id)}
                  className={`px-4 py-2 rounded-xl text-xs font-bold ${activeTab === t.id ? 'bg-purple-600 text-white' : 'bg-[#1c1c24] text-zinc-400 hover:text-white'}`}
                >
                  {t.label}
                </button>
              ))}
            </div>
          </div>

          {activeTab === 'lectures' && (
            <div className="p-6 rounded-2xl bg-[#141418] border border-[#272730] space-y-3">
              {chLectures.map((lec) => {
                const isDone = lec.status === 'Completed';
                return (
                  <div key={lec.id} className="p-4 rounded-xl bg-[#1b1b22] border border-[#2b2b36] flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <div className="text-xs font-extrabold text-white">Lecture {lec.lectureNumber}: {lec.topic}</div>
                      <div className="text-[11px] text-zinc-400 mt-0.5">
                        Date: <span className="text-purple-300">{formatDateDDMMMYYYY(lec.date)}</span> • Timing: {lec.timing} • Faculty: {lec.faculty}
