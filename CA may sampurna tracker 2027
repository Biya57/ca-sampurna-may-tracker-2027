                />
              </div>
              <div className="text-zinc-300">
                Projected Finish: <strong className="text-emerald-400">{formatDateDDMMMYYYY(stats.projectedCompletionDate)}</strong> (Required: <strong className="text-white">{stats.requiredDailyVelocity}</strong> lecs/day)
              </div>
            </div>
          </div>

          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div className="p-6 rounded-2xl bg-[#141418] border border-[#272730] space-y-4">
              <div className="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <h3 className="text-base font-black text-white">Today's Scheduled Lectures</h3>
                  <p className="text-xs text-zinc-400">Schedule for {formatDateDDMMMYYYY(selectedDashboardDate)}</p>
                </div>
                <input
                  type="date"
                  value={selectedDashboardDate}
                  onChange={(e) => setSelectedDashboardDate(e.target.value)}
                  className="px-2.5 py-1.5 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white"
                />
              </div>

              {todaysLectures.length === 0 ? (
                <div className="p-4 rounded-xl bg-[#1b1b22] border border-[#292934] text-xs text-zinc-400">
                  No live lectures on {formatDateDDMMMYYYY(selectedDashboardDate)}. Jump to{' '}
                  <button onClick={() => setSelectedDashboardDate('2026-11-16')} className="text-purple-400 underline font-bold">
                    16 Nov 2026
                  </button>{' '}
                  to inspect Day 1 classes.
                </div>
              ) : (
                <div className="space-y-2.5">
                  {todaysLectures.map((lec) => {
                    const subj = SUBJECTS.find((s) => s.id === lec.subjectId);
                    const ch = appData.chapters.find((c) => c.id === lec.chapterId);
                    const isDone = lec.status === 'Completed';
                    return (
                      <div key={lec.id} className="p-3.5 rounded-xl bg-[#1b1b22] border border-[#2b2b36] flex items-center justify-between gap-3">
                        <div className="min-w-0">
                          <div className="text-[10px] font-bold text-purple-400 uppercase">{subj?.name} • {lec.timing}</div>
                          <div className="text-xs font-extrabold text-white truncate">{ch?.name} — Lec {lec.lectureNumber}</div>
                        </div>
                        <button
                          onClick={() => toggleLectureStatus(lec.id)}
                          className={`px-3 py-1.5 rounded-xl text-xs font-bold shrink-0 ${isDone ? 'bg-emerald-600 text-white' : 'bg-[#252530] hover:bg-purple-600 text-zinc-200'}`}
                        >
                          {isDone ? 'Completed' : 'Mark Done'}
                        </button>
                      </div>
                    );
                  })}
                </div>
              )}

              <div className="grid grid-cols-3 gap-2.5 pt-2 text-center">
                <div className="p-3 rounded-xl bg-[#1b1b22] border border-[#292934]">
                  <div className="text-lg font-black text-purple-400">{stats.pendingLectures}</div>
                  <div className="text-[10px] text-zinc-400 font-bold uppercase">Pending Lecs</div>
                </div>
                <div className="p-3 rounded-xl bg-[#1b1b22] border border-[#292934]">
                  <div className="text-lg font-black text-amber-400">{pendingDpps.length}</div>
                  <div className="text-[10px] text-zinc-400 font-bold uppercase">Pending DPPs</div>
                </div>
                <div className="p-3 rounded-xl bg-[#1b1b22] border border-[#292934]">
                  <div className="text-lg font-black text-emerald-400">{dueRevisions.length}</div>
                  <div className="text-[10px] text-zinc-400 font-bold uppercase">Revisions</div>
                </div>
              </div>
            </div>

            <div className="p-6 rounded-2xl bg-[#141418] border border-[#272730] space-y-4">
              <div className="flex items-center justify-between">
                <div>
                  <h3 className="text-base font-black text-white">Daily Mission</h3>
                  <p className="text-xs text-zinc-400">Your daily study targets & checklist</p>
                </div>
                <span className="text-sm font-black text-emerald-400">{dailyMissionPct}% Done</span>
              </div>
              <div className="w-full h-2 rounded-full bg-zinc-800 overflow-hidden">
                <div className="h-full bg-emerald-500 transition-all duration-300" style={{ width: `${dailyMissionPct}%` }} />
              </div>
              <form onSubmit={handleAddDailyTask} className="flex gap-2">
                <input
                  type="text"
                  value={newTaskText}
                  onChange={(e) => setNewTaskText(e.target.value)}
                  placeholder="Add task e.g. Complete 2 Accounting lectures..."
                  className="flex-1 px-3 py-2 rounded-xl bg-[#1c1c24] border border-[#2e2e3a] text-xs text-white"
                />
                <button type="submit" className="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold">
                  Add
                </button>
              </form>
              <div className="space-y-2 max-h-60 overflow-y-auto">
                {appData.dailyTasks.map((task) => (
                  <div key={task.id} className="p-3 rounded-xl bg-[#1b1b22] border border-[#2b2b36] flex items-center justify-between gap-2">
                    <button
                      onClick={() =>
                        setAppData((prev) => ({
                          ...prev,
                          dailyTasks: prev.dailyTasks.map((t) => t.id === task.id ? { ...t, completed: !t.completed } : t)
                        }))
                      }
                      className="flex items-center gap-2.5 text-left flex-1"
                    >
                      {task.completed ? <CheckSquare className="w-4 h-4 text-emerald-400 shrink-0" /> : <Square className="w-4 h-4 text-zinc-500 shrink-0" />}
                      <span className={`text-xs font-semibold ${task.completed ? 'line-through text-zinc-500' : 'text-zinc-200'}`}>{task.text}</span>
                    </button>
                    <button
                      onClick={() => setAppData((prev) => ({ ...prev, dailyTasks: prev.dailyTasks.filter((t) => t.id !== task.id) }))}
                      className="text-zinc-500 hover:text-rose-400"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      );
    }

