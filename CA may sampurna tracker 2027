    // 7. FOCUS TIMER
    function FocusTimerView({ appData, setAppData, todayISO, showToast }) {
      const [durationMins, setDurationMins] = useState(50);
      const [secondsLeft, setSecondsLeft] = useState(50 * 60);
      const [isRunning, setIsRunning] = useState(false);

      useEffect(() => {
        if (!isRunning) return;
        const interval = setInterval(() => {
          setSecondsLeft((prev) => {
            if (prev <= 1) {
              setIsRunning(false);
              setAppData((old) => ({
                ...old,
                focusSessions: [{ id: `focus-${Date.now()}`, minutes: durationMins, date: todayISO }, ...old.focusSessions]
              }));
              showToast(`Focus session (${durationMins}m) completed & recorded!`);
              return durationMins * 60;
            }
            return prev - 1;
          });
        }, 1000);
        return () => clearInterval(interval);
      }, [isRunning, durationMins, todayISO, setAppData, showToast]);

      const mins = String(Math.floor(secondsLeft / 60)).padStart(2, '0');
      const secs = String(secondsLeft % 60).padStart(2, '0');
      const todayMinutes = appData.focusSessions.filter((s) => s.date === todayISO).reduce((acc, s) => acc + Number(s.minutes || 0), 0);
      const totalMinutes = appData.focusSessions.reduce((acc, s) => acc + Number(s.minutes || 0), 0);

      return (
        <div className="max-w-2xl mx-auto space-y-6 animate-view-enter">
          <div className="p-8 rounded-2xl bg-[#141418] border border-[#272730] text-center space-y-6">
            <h1 className="text-xl font-black text-white">Pomodoro Focus Timer</h1>
            <div className="flex flex-wrap justify-center gap-2">
              {[25, 50, 90].map((m) => (
                <button
                  key={m}
                  onClick={() => { setIsRunning(false); setDurationMins(m); setSecondsLeft(m * 60); }}
                  className={`px-4 py-2 rounded-xl text-xs font-bold ${durationMins === m ? 'bg-purple-600 text-white' : 'bg-[#1c1c24] text-zinc-400'}`}
                >
                  {m} Minutes
                </button>
              ))}
            </div>
            <div className="text-6xl font-black text-white font-mono tracking-wider">{mins}:{secs}</div>
            <div className="flex justify-center gap-3">
              <button onClick={() => setIsRunning(!isRunning)} className="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black uppercase tracking-wider">
                {isRunning ? 'Pause' : 'Start Focus'}
              </button>
              <button onClick={() => { setIsRunning(false); setSecondsLeft(durationMins * 60); }} className="px-6 py-3 rounded-xl bg-[#1c1c24] text-zinc-300 text-xs font-bold">
                Reset
              </button>
            </div>
            <div className="grid grid-cols-3 gap-3 pt-4 border-t border-[#252530]">
              <div className="p-3 rounded-xl bg-[#1b1b22]">
                <div className="text-lg font-black text-purple-400">{(todayMinutes / 60).toFixed(1)}h</div>
                <div className="text-[10px] text-zinc-400 uppercase font-bold">Today's Study</div>
              </div>
              <div className="p-3 rounded-xl bg-[#1b1b22]">
                <div className="text-lg font-black text-emerald-400">{(totalMinutes / 60).toFixed(1)}h</div>
                <div className="text-[10px] text-zinc-400 uppercase font-bold">Total Logged</div>
              </div>
              <div className="p-3 rounded-xl bg-[#1b1b22]">
                <div className="text-lg font-black text-white">{appData.focusSessions.length}</div>
                <div className="text-[10px] text-zinc-400 uppercase font-bold">Sessions Done</div>
              </div>
            </div>
          </div>
        </div>
      );
    }

