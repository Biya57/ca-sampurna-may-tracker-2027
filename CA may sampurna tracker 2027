        e.preventDefault();
        if (!newTaskText.trim()) return;
        setAppData((prev) => ({
          ...prev,
          dailyTasks: [...prev.dailyTasks, { id: `dt-${Date.now()}`, text: newTaskText.trim(), completed: false }]
        }));
        setNewTaskText('');
        showToast('Daily mission task added!');
